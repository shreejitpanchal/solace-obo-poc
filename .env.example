# Copy to .env (gitignored) and adjust. docker compose reads .env automatically;
# for host runs, export the variables or use `uv run --env-file .env <command>`.
# Values here are the dev-container defaults, not real credentials.

# --- broker: local container or external ----------------------------------
# local (default): the solace service in docker-compose.yml runs; containers
# reach it as tcp://solace:55555 and host runs as tcp://localhost:55555, so
# leave SOLACE_HOST unset.
COMPOSE_PROFILES=local-broker
# PubSub+ Enterprise image, loaded locally (docker load / docker image ls).
# Set to the tag you have, e.g. solace-pubsub-enterprise:10.26.0.9000.
SOLACE_IMAGE=solace-pubsub-enterprise:10.25.0.246
SOLACE_ADMIN_PASSWORD=admin                          # broker admin (PubSub+ Manager on :8080)
TZ=Asia/Singapore                                    # broker container time zone
ISSUER_PORT=8001                                     # host port for the issuer (8000 is the broker's MQTT/WS)

# external: set COMPOSE_PROFILES empty (no broker container) and point every
# service, in compose and on the host alike, at the external broker.
# For a broker running on this machine (not in compose) use
# tcp://host.docker.internal:55555 for compose and tcp://localhost:55555 on the host.
#COMPOSE_PROFILES=
#SOLACE_HOST=tcp://broker.example.com:55555
#SOLACE_VPN=default
#SOLACE_USERNAME=default
#SOLACE_PASSWORD=change-me

# --- consumer queues -------------------------------------------------------
# Each consumer binds to its own durable exclusive queue:
#   <prefix>.validator, <prefix>.recipient.<thread-id>, <prefix>.profiler.<sender-id>,
#   <prefix>.news.<app> for each of the six news consumers (Kai-Go-Mobile, Kai-Go-Desktop,
#   Kai-Signals-Engine, Kai-StoreFront, Kai-Cowork, Kai-Zen), all on poc/news-validate/>
# SOLACE_CREATE_QUEUES=true creates a missing queue and its topic subscription
# on start (needs "allow guaranteed endpoint create" on the client profile).
# Set false on a broker where the queues are pre-provisioned by an admin.
SOLACE_QUEUE_PREFIX=q.poc
SOLACE_CREATE_QUEUES=true

# --- queue provisioning (obo-provision, the compose `provision` service) ------
# Runs before the consumers and creates every queue above over SEMP v2 with a
# message TTL: respectTtlEnabled=true, maxTtl=QUEUE_MAX_TTL_SECONDS. 86400 =
# messages older than 24 hours are expired from the queue. Idempotent.
# SEMP_URL inside compose defaults to http://solace:8080 (the local broker);
# for an external broker set it to that broker's management URL, and set
# SEMP_USERNAME / SEMP_PASSWORD to an admin there (defaults: admin / the
# SOLACE_ADMIN_PASSWORD above). Host runs use http://localhost:8080.
QUEUE_MAX_TTL_SECONDS=86400
PROVISION_TIMEOUT_SECONDS=180                        # how long to wait for SEMP while the broker boots
#SEMP_URL=http://broker.example.com:8080
#SEMP_USERNAME=admin
#SEMP_PASSWORD=change-me

# --- publisher arguments and the recipient / profiler filters --------------
SENDER_ID=alice
THREAD_ID=t-1
MESSAGE=hello from poc in docker
# The news publisher uses the same SENDER_ID / THREAD_ID with --kind news.
NEWS_MESSAGE=breaking news from poc in docker
# The publisher runs continuously: one event every PUBLISH_INTERVAL_SECONDS
# (decimal allowed), refreshing its OBO token before expiry. PUBLISH_COUNT=0
# means until stopped; a positive number publishes that many events and exits.
PUBLISH_INTERVAL_SECONDS=5
PUBLISH_COUNT=0

# --- logging ---------------------------------------------------------------
# INFO logs each activity once (token obtained, message received, token
# verified, forwarded / delivered, refused). DEBUG adds every check and
# broker call. Tokens are always masked.
LOG_LEVEL=INFO

# --- token settings (compose and host runs) --------------------------------
OBO_ISSUER=solace-obo-poc-issuer
OBO_AUDIENCE=poc
OBO_TOKEN_TTL_SECONDS=300
# Host runs only; compose always uses the issuer container. Use
# http://127.0.0.1:${ISSUER_PORT} (8001) to reach the containerised issuer from the host.
OBO_ISSUER_URL=http://127.0.0.1:8000
